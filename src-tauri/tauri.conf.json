{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lemaan",
  "version": "0.1.1",
  "identifier": "com.lemaan.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5010",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "למען — מערכת לימוד וחזרות",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
